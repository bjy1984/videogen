# Copy to .env.local and fill values. .env.local is ignored by git.

NEWAPI_BASE_URL=https://apicoco.com
NEWAPI_USERNAME=
NEWAPI_PASSWORD=
NEWAPI_API_KEY=

OSS_BUCKET=
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=videogen

# Optional: if you expose the local /assets directory through a public tunnel/domain.
VIDEOGEN_PUBLIC_ASSET_BASE_URL=
IMAGE2_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
IMAGE2_API_KEY=
IMAGE2_MODEL=openai/gpt-5.4-image-2
# Set to passthrough only for local UI testing without calling image2.
IMAGE2_MOCK=
